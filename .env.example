# Local development settings
TEAM_INVITE_CODE=local-team-code
DEV_INVITE_CODE=local-dev-code
APP_URL=http://localhost:5173

# Resend email settings: replace these with your Resend API key and a sender
# address on a domain verified in Resend.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="Digem <notifications@your-verified-domain.com>"

